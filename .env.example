# Copy to .env and fill in. .env is gitignored.

# tModLoader release to build, from https://github.com/tModLoader/tModLoader/releases
TMLVERSION=v2026.08.2.1

# The uid and gid of the `terraria` service account on the host — the one created with
#   useradd --create-home --home-dir <data> --shell /usr/sbin/nologin terraria
# Read them off `id terraria` and paste them here. These are what the world files end up
# owned by; get them wrong and the server writes files the host account cannot read.
#
# Baked in at BUILD time, not runtime, so changing them needs `docker compose build`,
# not just a restart.
TML_UID=1000
TML_GID=1000

# Host path for worlds, mods and configs.
DATA_DIR=/srv/terraria
TML_PORT=7777
