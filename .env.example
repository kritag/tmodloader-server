# Copy to .env and fill in. .env is gitignored.

# tModLoader release to build, from https://github.com/tModLoader/tModLoader/releases
TMLVERSION=v2026.08.2.1

# Host account that owns the world files. Baked in at build time, so changing these
# requires `docker compose build`, not just a restart.
TML_UID=1000
TML_GID=1000

# Host path for worlds, mods and configs.
DATA_DIR=/srv/terraria
TML_PORT=7777
